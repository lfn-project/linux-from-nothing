#!/bin/sh

mkdir -p /proc /sys /dev /tmp /run
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

hostname lfn-live

echo -n "[  ...  ] Activating lo interface..."
if ifconfig lo 127.0.0.1 up 2>/dev/null; then
    echo -e "\r[  \033[01;32mOK\033[00m  ] Activating lo interface."
else
    echo -e "\r[ \033[01;31mFAIL\033[00m ] Activating lo interface."
fi

echo -n "[  ...  ] Detecting network hardware..."
IFACE=$(ifconfig -a | grep -v 'lo' | grep 'Link' | awk '{print $1}' | head -n 1)

if [ -z "$IFACE" ]; then
    echo -e "\r[ \033[01;31mFAIL\033[00m ] No network interface detected!"
    NET_STATUS="Disconnected"
else
    echo -e "\r[  \033[01;32mOK\033[00m  ] Detected network interface: $IFACE"
    ifconfig $IFACE up 2>/dev/null

    echo -n "[  ...  ] Requesting IP via DHCP..."
    udhcpc -q -n -b -i $IFACE >/dev/null 2>&1

    TIMEOUT=10
    while [ $TIMEOUT -gt 0 ]; do
        if ifconfig $IFACE | grep -q 'inet addr:'; then
            break
        fi
        sleep 1
        TIMEOUT=$((TIMEOUT - 1))
    done

    if [ $TIMEOUT -gt 0 ]; then
        IP_ADDR=$(ifconfig $IFACE | grep 'inet addr:' | awk '{print $2}' | cut -d: -f2)
        echo -e "\r[  \033[01;32mOK\033[00m  ] Network connected."
        NET_STATUS="Connected (IP: $IP_ADDR)"
    else
        echo -e "\r[ \033[01;33mWARN\033[00m ] DHCP timeout."
        NET_STATUS="Disconnected (Timeout)"
    fi
fi

sleep 1


clear

KERNEL_VER=$(uname -r)
CPU_MODEL=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^[ \t]*//')
MEM_TOTAL=$(grep 'MemTotal' /proc/meminfo | awk '{print $2/1024 " MB"}')

echo "Linux From Nothing Alpha 0.1 (lfn-live) tty1"
echo ""
echo "  Kernel version : $KERNEL_VER"
echo "  Processor      : $CPU_MODEL"
echo "  Total Memory   : $MEM_TOTAL"
echo "  Network Status : $NET_STATUS"
echo ""
echo "Type 'help' for available commands."
echo ""

exec setsid cttyhack /bin/sh

